+// processEndpoint does one round of protocol work for an endpoint that has
+// segments queued (or an inline error to act on), and reports whether it
+// should be queued again because segments remain and no user holds it.
+func processEndpoint(ep *Endpoint) bool {
+	if ep.segmentQueue.empty() && !ep.inlineDeferred.Load() {
+		return false
+	}
+	switch state := ep.EndpointState(); {
+	case state.connecting():
+		handleConnecting(ep)
+	case state.connected() && state != StateTimeWait:
+		handleConnected(ep)
+	case state == StateTimeWait:
+		handleTimeWait(ep)
+	case state == StateListen:
+		handleListen(ep)
+	case state == StateError || state == StateClose:
+		// Try to redeliver any still queued packets to another endpoint
+		// or send a RST if it can't be delivered.
+		ep.mu.Lock()
+		if st := ep.EndpointState(); st == StateError || st == StateClose {
+			ep.drainClosingSegmentQueue()
+		}
+		ep.mu.Unlock()
+	default:
+		panic(fmt.Sprintf("unexpected tcp state in processor: %v", state))
+	}
+	// If there is more to do -- segments, or an inline error this round
+	// could not take because a user held the endpoint -- and the endpoint
+	// lock is not held by a user, requeue it for processing.
+	return (!ep.segmentQueue.empty() || ep.inlineDeferred.Load()) && !ep.isOwnedByUser()
+}
+
+// BatchProcessing, when true, keeps the work the inline fast path cannot do
+// — a listener's SYN and the handshake it starts, a connection's FIN and
+// close, anything that changes state or needs the demuxer's write lock — on
+// the goroutine that delivered the segments, run after the delivery batch
+// through DrainDeferred instead of waking a processor goroutine for it. The
+// delivering goroutine holds the demuxer's read lock during the batch and
+// nothing afterwards, so the deferred work can take any lock. A link
+// endpoint that delivers in batches calls DrainDeferred after each; the
+// processor goroutines remain for work other goroutines (timers) queue.
+var BatchProcessing bool
+
+// queueEndpoint hands an endpoint with queued segments to whoever processes
+// it next: the delivering goroutine's after-batch pass, or a processor.
+func (d *dispatcher) queueEndpoint(id stack.TransportEndpointID, ep *Endpoint) {
+	if BatchProcessing {
+		d.deferred.enqueue(ep)
+		return
+	}
+	d.selectProcessor(id).queueEndpoint(ep)
+}
+
+// drainDeferred runs the deferred work; see BatchProcessing.
+func (d *dispatcher) drainDeferred() {
+	for {
+		ep := d.deferred.dequeue()
+		if ep == nil {
+			return
+		}
+		if processEndpoint(ep) {
+			d.deferred.enqueue(ep)
+		}
+	}
+}
+
+// DrainDeferred runs, on the calling goroutine, the protocol work that
+// BatchProcessing set aside for after the delivery batch. The caller must
+// hold no stack lock.
+func DrainDeferred(s *stack.Stack) {
+	if p, ok := s.TransportProtocolInstance(ProtocolNumber).(*protocol); ok {
+		p.dispatcher.drainDeferred()
+	}
+}
+
 // pause pauses the processor loop.
 func (p *processor) pause() chan struct{} {
 	p.pauseWaker.Assert()
@@ -393,6 +450,7 @@ func (p *processor) resume() {
 // +stateify savable
 type dispatcher struct {
 	processors []processor
+	deferred   epQueue        // work set aside for DrainDeferred (see BatchProcessing)
 	wg         sync.WaitGroup `state:"nosave"`
 	hasher     jenkinsHasher
 	mu         dispatcherMutex `state:"nosave"`
@@ -505,8 +563,67 @@ func (d *dispatcher) queuePacket(stackEP stack.TransportEndpoint, id stack.Trans
 	// goroutine as endpoint.UnlockUser will wake up the processor if the
 	// segment queue is not empty.
 	if !ep.isOwnedByUser() {
-		d.selectProcessor(id).queueEndpoint(ep)
+		if InlineProcessing && s.flags&(header.TCPFlagSyn|header.TCPFlagRst|header.TCPFlagFin) == 0 &&
+			ep.EndpointState() == StateEstablished && handleEstablishedInline(ep, pkt.Hash) {
+			if !ep.segmentQueue.empty() && !ep.isOwnedByUser() {
+				d.queueEndpoint(id, ep)
+			}
+			return
+		}
+		d.queueEndpoint(id, ep)
+	}
+}
+
+// InlineProcessing, when true, lets an established connection's inbound
+// segments be processed on the goroutine that delivered them when the
+// endpoint is uncontended, instead of always handing them to a processor
+// goroutine. That saves one goroutine wakeup per inbound batch, which on a
+// low-latency link is a large share of a request's round trip. Per-connection
+// ordering is unchanged: a connection's segments arrive on one goroutine, and
+// the endpoint lock serializes it against the processor and timers.
+//
+// Only segments that cannot close the connection are handled this way (no
+// SYN, RST or FIN, and only in ESTABLISHED), because the delivering caller
+// holds the transport demuxer's read lock and closing an endpoint needs it
+// for writing. Anything unexpected is left to the processor.
+var InlineProcessing bool
+
+// TxHashFromRx, when true, sets a connection's transmit hash (which picks
+// the link endpoint's transmit queue) from the receive hash of each inbound
+// segment it processes inline, so replies leave on the queue the request
+// arrived on. The link endpoint must set pkt.Hash to its receive queue for
+// this to mean anything.
+var TxHashFromRx bool
+
+// handleEstablishedInline is handleConnected for the inline fast path. It
+// reports false, having done nothing the processor would not redo, when the
+// endpoint is contended or when processing produced an error or a state
+// change — those need the processor, which runs without the demuxer lock.
+func handleEstablishedInline(ep *Endpoint, rxHash uint32) bool {
+	if !ep.TryLock() {
+		return false
+	}
+	if ep.EndpointState() != StateEstablished {
+		ep.mu.Unlock()
+		return false
 	}
+	if TxHashFromRx {
+		// Transmit on whatever queue the peer's segments arrive on: the link
+		// endpoint that set pkt.Hash to its receive queue then sends the
+		// reply on the socket owned by the goroutine handling it.
+		ep.txHash = rxHash
+	}
+	err := ep.handleSegmentsLocked()
+	if err != nil || ep.EndpointState() != StateEstablished {
+		// Cannot be finished here (see InlineProcessing); hand the error,
+		// if any, to the processor along with the endpoint.
+		ep.inlineErr = err
+		ep.inlineDeferred.Store(true)
+		ep.mu.Unlock()
+		return false
+	}
+	ep.mu.Unlock()
+	return true
 }
 
