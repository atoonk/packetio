+	// endpoint's turn: linkBlocked then only marks, and ResumeBlocked
+	// decides where in line the endpoint goes.
+	linkResuming bool `state:"nosave"`
+	// linkTurns, under mu, counts the turns ResumeBlocked gave this
+	// endpoint: one that never had any joins the front of the line, the
+	// way a fair queue lets a new flow's first packets through first.
+	linkTurns uint32 `state:"nosave"`
+
 	// txHash is the transport layer hash to be set on outbound packets
 	// emitted by this endpoint.
 	txHash uint32
@@ -1212,6 +1232,7 @@ func (e *Endpoint) cleanupLocked() {
 		e.snd.probeTimer.cleanup()
 		e.snd.reorderTimer.cleanup()
 		e.snd.corkTimer.cleanup()
+		e.snd.delayedAckTimer.cleanup()
 	}
 
 	if e.finWait2Timer != nil {
@@ -1692,6 +1713,49 @@ func (e *Endpoint) queueSegment(p tcpip.Payloader, opts tcpip.WriteOptions) (*se
 //
 // +checklocksexclude:e.segmentQueue.mu
 // +checklocksexclude:e.pendingProcessingMu
+// WriteExternal queues vs — payload that already lives in memory the caller
+// owns (buffer.NewViewFromExternal) — without copying it, as one segment,
+// and sends what the window allows. Handing it a GSO packet's worth of views
+// at a time keeps the per-segment work of the send path per packet. It is
+// all or nothing: if the send buffer cannot take every view it returns
+// ErrWouldBlock and the caller keeps them; otherwise the endpoint owns them
+// from here, and each view's release runs once the peer has acknowledged
+// every byte and the link has let go of every clone.
+func (e *Endpoint) WriteExternal(vs []*buffer.View) (int64, tcpip.Error) {
+	e.LockUser()
+	defer e.UnlockUser()
+
+	size := 0
+	for _, v := range vs {
+		size += v.Size()
+	}
+	if size == 0 {
+		return 0, nil
+	}
+	e.sndQueueInfo.sndQueueMu.Lock()
+	avail, err := e.isEndpointWritableLocked()
+	if err != nil {
+		e.sndQueueInfo.sndQueueMu.Unlock()
+		e.stats.WriteErrors.WriteClosed.Increment()
+		return 0, err
+	}
+	if avail < size {
+		e.sndQueueInfo.sndQueueMu.Unlock()
+		return 0, &tcpip.ErrWouldBlock{}
+	}
+	buf := buffer.MakeWithView(vs[0])
+	for _, v := range vs[1:] {
+		buf.Append(v) // external views read as shared, so this links, never copies
+	}
+	s := newOutgoingSegment(e.TransportEndpointInfo.ID, e.stack.Clock(), buf, e.ops.GetMark())
+	e.sndQueueInfo.SndBufUsed += size
+	e.snd.writeList.PushBack(s)
+	e.sndQueueInfo.sndQueueMu.Unlock()
+
+	e.sendData(s)
+	return int64(size), nil
+}
+
 func (e *Endpoint) Write(p tcpip.Payloader, opts tcpip.WriteOptions) (int64, tcpip.Error) {
 	// Linux completely ignores any address passed to sendto(2) for TCP sockets
 	// (without the MSG_FASTOPEN flag). Corking is unimplemented, so opts.More
@@ -3490,3 +3554,76 @@ func (e *Endpoint) getExperimentOptionValue(route *stack.Route) uint16 {
 	}
 	return 0
 }
+
+// linkBlocked records that the link refused this endpoint's last segment
+// (see LinkBackpressure) and queues it for ResumeBlocked.
+//
+// +checklocks:e.mu
+func (e *Endpoint) linkBlocked() {
+	if e.blockedByLink.CompareAndSwap(false, true) && !e.linkResuming {
+		e.protocol.blockedMu.Lock()
+		if e.linkTurns == 0 {
+			e.protocol.blocked = append([]*Endpoint{e}, e.protocol.blocked...)
+		} else {
+			e.protocol.blocked = append(e.protocol.blocked, e)
+		}
+		e.protocol.blockedMu.Unlock()
+	}
+}
+
+// ResumeBlocked gives the endpoints the link refused, in the order it
+// refused them, a turn to send (LinkTurn segments each) and stops at the
+// first the link refuses again, leaving it and the rest in line. The link
+// calls it, with no stack lock held, whenever its backlog has room.
+func ResumeBlocked(s *stack.Stack) {
+	p, ok := s.TransportProtocolInstance(ProtocolNumber).(*protocol)
+	if !ok {
+		return
+	}
+	p.blockedMu.Lock()
+	eps := p.blocked
+	if len(eps) == 0 {
+		p.blockedMu.Unlock()
+		return
+	}
+	p.blocked = nil
+	p.blockedMu.Unlock()
+	for i, ep := range eps {
+		ep.mu.Lock()
+		ep.blockedByLink.Store(false)
+		ep.linkRefused = false
+		ep.linkResuming = true
+		if ep.EndpointState().connected() && ep.snd != nil {
+			// The turn is bounded only while others wait; alone, it may
+			// send until the link refuses.
+			p.blockedMu.Lock()
+			others := i+1 < len(eps) || len(p.blocked) > 0
+			p.blockedMu.Unlock()
+			if others {
+				ep.snd.linkTurn = LinkTurn
+			}
+			ep.snd.sendData()
+			ep.snd.linkTurn = 0
+			ep.linkTurns++
+		}
+		ep.linkResuming = false
+		refused, blocked := ep.linkRefused, ep.blockedByLink.Load()
+		ep.mu.Unlock()
+		switch {
+		case refused:
+			// The link is full again: this endpoint and the rest keep
+			// their places, ahead of anyone who joined the line meanwhile.
+			p.blockedMu.Lock()
+			rest := make([]*Endpoint, 0, len(eps)-i+len(p.blocked))
+			rest = append(rest, eps[i:]...)
+			p.blocked = append(rest, p.blocked...)
+			p.blockedMu.Unlock()
+			return
+		case blocked:
+			// Its turn is used up and it has more: back to the end.
+			p.blockedMu.Lock()
+			p.blocked = append(p.blocked, ep)
+			p.blockedMu.Unlock()
+		}
+	}
+}
